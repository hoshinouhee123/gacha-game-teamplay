{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "ea2d1811d2d24d0f893c816475c51933",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "GaussionBlur (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -568.9998168945313,
            "y": 91.00009155273438,
            "width": 228.49984741210938,
            "height": 349.9998779296875
        }
    },
    "m_Slots": [
        {
            "m_Id": "7c34a6f3be5742c0a581de293f3d80fa"
        },
        {
            "m_Id": "158cac094228416fa52cb5e774400ec5"
        },
        {
            "m_Id": "5a8fd98074e74640890429faaf41abdc"
        },
        {
            "m_Id": "89075176a4f142fba23cf22a3492320d"
        },
        {
            "m_Id": "4dd943038bfa43df898194f65cac491d"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "GaussionBlur",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// ブラー値が0以下の場合は、そのままのピクセルを返して処理を軽くする\nif (blur <= 0)\n{\n    col = SAMPLE_TEXTURE2D(grabTexture.tex, grabTexture.samplerstate, grabTexture.GetTransformedUV(grabPos.xy));\n    return;\n}\n\ncol = float4(0, 0, 0, 0);\nfloat weight_total = 0;\nfloat uvPitchX = _CameraSortingLayerTexture_TexelSize.x;\nfloat uvPitchY = _CameraSortingLayerTexture_TexelSize.y;\n\n// XとYのループを入れ子にして、四角い範囲をまとめてサンプリング\nfor (float x = -blur; x <= blur; x += 1)\n{\n    for (float y = -blur; y <= blur; y += 1)\n    {\n        // 2Dの距離の2乗を計算（x^2 + y^2）\n        float distance_sq_normalized = (x * x + y * y) / (blur * blur);\n        \n        // ガウス分布に基づく重み付け\n        float weight = exp(-0.5 * distance_sq_normalized * 5.0);\n        weight_total += weight;\n        \n        // UV座標をずらしてサンプリング\n        float2 uv = grabPos.xy + float2(x * uvPitchX, y * uvPitchY);\n        col += SAMPLE_TEXTURE2D(grabTexture.tex, grabTexture.samplerstate, grabTexture.GetTransformedUV(uv)) * weight;\n    }\n}\n\ncol /= weight_total;\n"
}

